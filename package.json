{
  "name": "regavo-rts",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:smoke": "playwright test",
    "check:deployment": "node scripts/check-deployment.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "check:licenses": "node scripts/audit-licenses.mjs --check",
    "check:assets": "node scripts/check-runtime-assets.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate": "pnpm lint && pnpm format:check && pnpm check && pnpm check:licenses && pnpm test && pnpm build && pnpm check:assets",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', 'coverage', '.eslintcache', 'tsconfig.tsbuildinfo']) rmSync(path, { recursive: true, force: true });\""
  },
  "dependencies": {
    "pixi.js": "8.13.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.13.0"
  }
}
