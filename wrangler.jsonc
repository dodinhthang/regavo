{
  "name": "regavo",
  "main": "./src/cloudflare-worker.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
}
